<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wall of Love</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      background-color: #f7f7f7;
    }

    .container-flex {
      display: flex;
      flex-wrap: wrap;
      max-width: 1000px;
      margin: 0 auto;
      background-color: white;
      padding: 40px;
      min-height: 100vh;
    }

    .left {
      flex: 1;
      min-width: 300px;
      padding-right: 20px;
    }

    .left h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .left p {
      font-size: 16px;
      margin-bottom: 30px;
    }

    .left img {
      max-width: 100%;
      height: auto;
    }

    .right {
      flex: 1;
      min-width: 300px;
    }

    .testimonial-section {
      background-color: #E9D6C6;
      padding: 20px;
      border-radius: 8px;
    }

    .testimonial-section h3 {
      font-weight: bold;
    }

    .testimonial-section img {
      object-fit: cover;
    }

    .info-container {
      border-radius: 8px;

    }

    #carouselExampleDark .carousel-inner {
      background-color: #E9D6C6;
      border-radius: 8px;
    }

    #carouselExampleDark .carousel-item {
      padding: 20px;
      background-color: #E9D6C6;
    }

    .carousel-control-prev,
    .carousel-control-next {
      filter: invert(1);
    }


    .left>*:not(:last-child),
    .right>*:not(:last-child) {
      margin-bottom: 20px;
    }

    .info-container {
      padding: 15px;
      margin-top: 20px;
      margin-bottom: 20px;
    }

    .left button {
      margin-bottom: 15px;
    }

    .left img {
      margin-top: 20px;
      border-radius: 8px;
    }

    .navbar {
      margin-bottom: 30px;
    }

    .testimonial-section {
      margin-top: 20px;
    }

    footer {
      padding: 20px 0;
    }
  </style>
</head>

<body>
  <div class="container-flex">
    <!-- Left Column -->
    <div class="left">
      <h1>Wall of Love 📚₊˚⊹ 💗</h1>
      <img src="{{book.image_url}}" alt="Illustration" />

      <button type="button" class="btn btn-outline-light" style="background-color: #E3A4BD">Leave some Love</button>

      <div class="info-container" style="background-color:#cedd9e; padding: 1rem; border-radius: 8px;">
        <h4>About the Book</h4>
        <p><strong>Title:</strong> {{book.title}}</p>
        <p><strong>Author:</strong> {{book.author}}</p>
        <p><strong>Genre:</strong> {{book.genre}}</p>
        <p><strong>Published:</strong> {{book.publication_year}}</p>
        <p><strong>Description:</strong> {{book.description}}</p>
        <a href="{{book.link}}" title="Go to more information" target="_blank" rel="noopener noreferrer">More
          Information</a>
      </div>


    </div>

    <!-- Right Column -->
    <div class="right">


      <div class="btn-group mb-3">
        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="sortDropdown"
          data-bs-toggle="dropdown" aria-expanded="false">
          Sort By
        </button>
        <ul class="dropdown-menu">
          <li><a class="dropdown-item sort-option" href="#" data-rating="all">All Ratings</a></li>
          <li><a class="dropdown-item sort-option" href="#" data-rating="5">5 Stars</a></li>
          <li><a class="dropdown-item sort-option" href="#" data-rating="4">4 Stars</a></li>
          <li><a class="dropdown-item sort-option" href="#" data-rating="3">3 Stars</a></li>
        </ul>
      </div>

      <section class="testimonial-section">
        <div class="row text-center">
          <div class="col-md-12">
            <div id="carouselExampleDark" class="carousel carousel-dark slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                {{#each book.reviews}}
                <div class="carousel-item {{#if @first}}active{{/if}}" data-rating="{{this.review_rating}}">
                  <p class="lead font-italic mx-4 mx-md-5">"{{this.review_text}}"</p>

                  <div class="reviewer-info d-flex align-items-center justify-content-center mb-3">
                    <img src="{{this.avatar}}" class="rounded-circle img-fluid shadow-1-strong me-3" width="80"
                      height="80" alt="{{this.reviewer}}"
                      onerror="this.src='https://mdbcdn.b-cdn.net/img/Photos/Avatars/img%20(10).webp'" />
                    <div class="text-start">
                      <p class="mb-1"><strong>{{this.reviewer}}</strong></p>
                      <p class="text-muted small mb-1">Reviewed on {{this.formatted_date}}</p>
                      <div class="rating">
                        {{this.stars}}
                        <span class="ms-2">({{this.review_rating}}/5)</span>
                      </div>
                    </div>
                  </div>
                </div>
                {{else}}
                <div class="carousel-item active">
                  <p class="lead font-italic mx-4 mx-md-5">No reviews yet for this book.</p>
                </div>
                {{/each}}
              </div>

              <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Initialize carousel
      const carousel = new bootstrap.Carousel(document.getElementById('carouselExampleDark'), {
        interval: false
      });

      // Sorting functionality
      document.querySelectorAll('.sort-option').forEach(option => {
        option.addEventListener('click', e => {
          e.preventDefault();
          const rating = option.getAttribute('data-rating');
          const items = document.querySelectorAll('#carouselExampleDark .carousel-item');

          items.forEach(item => item.style.display = 'none');

          let visibleItems = rating === 'all'
            ? Array.from(items)
            : Array.from(items).filter(item => item.getAttribute('data-rating') === rating);

          visibleItems.forEach((item, index) => {
            item.style.display = 'block';
            item.classList.toggle('active', index === 0);
          });

          if (visibleItems.length === 0) {
            document.querySelector('#carouselExampleDark .carousel-inner').innerHTML = `
              <div class="carousel-item active">
                <p class="lead font-italic mx-4 mx-md-5">No reviews found for this rating.</p>
              </div>`;
          }

          carousel.to(0);
        });
      });
    });
  </script>
</body>

</html>